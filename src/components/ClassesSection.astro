---
import { clases } from '../data/clases';
const whatsappUrl =
  'https://wa.me/5492617581623?text=Hola!%20Me%20gustar%C3%ADa%20obtener%20m%C3%A1s%20informaci%C3%B3n%20sobre%20las%20clases%20de%20Universo%20Pilates%20Cl%C3%A1sico.';
---

<section id="clases" class="section-padding" style="background-color: var(--color-surface);">
  <div class="max-w-screen-xl mx-auto px-6 section-container">

    <!-- Encabezado -->
    <div class="text-center mb-14 fade-in">
      <p class="text-sm uppercase tracking-[0.2em] font-semibold mb-4" style="color: var(--color-primary); margin-bottom: 1.5rem;">
        Nuestras Clases
      </p>
      <h2 class="heading-xl" style="color: var(--color-on-surface); margin-bottom: 1.5rem;">
        Un método, cinco aparatos.
      </h2>
      <div class="divider" style="margin-bottom: 1.5rem;"></div>
      <p class="body-lg max-w-6xl mx-auto mt-4" style="color: var(--color-on-surface-muted); margin-bottom: 1.5rem;">
        Utilizamos el equipamiento completo del Pilates Clásico para ofrecerte una experiencia integral y personalizada.
      </p>
    </div>

    <!-- Carrusel de clases -->
    <div class="classes-scroll fade-in text-center" role="list" style="margin-bottom: 2rem;">
      {clases.map((clase, i) => (
        <article class="classes-card card p-8" role="listitem" style="padding: .5rem .5rem;">
          <span
            class="text-5xl font-bold select-none"
            style="font-family: 'Cormorant Garamond', serif; color: var(--color-surface-high);"
            aria-hidden="true"
          >
            {String(i + 1).padStart(2, '0')}
          </span>

          <h3 class="heading-md mt-4 mb-2" style="color: var(--color-on-surface);">
            {clase.nombre}
          </h3>
          <p class="text-sm font-semibold uppercase tracking-wider mb-3" style="color: var(--color-primary);">
            {clase.descripcion}
          </p>
          <p class="text-sm leading-relaxed" style="color: var(--color-on-surface-muted);">
            {clase.detalle}
          </p>
        </article>
      ))}
    </div>

    <!-- CTA central -->
    <div class="flex justify-center">
      <div class="max-w-2xl text-center mx-auto fade-in section container">
        <p class="body-lg mt-6 mb-10" style="color: var(--color-on-surface-muted); margin-bottom: 1.5rem;">
          Si querés sentirte único y disfrutar de los beneficios del método Pilates, escribinos y empezá hoy mismo a entrenar de manera exclusiva como te merecés.
        </p>
        <!-- CTA WhatsApp principal -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary text-base inline-flex"
          style="margin-bottom: 1.5rem;"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Escribinos por WhatsApp
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .classes-scroll {
    display: flex;
    gap: 1.25rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-left: 1.5rem;
    padding-bottom: 0.75rem;
    /* Scrollbar estilizada */
    scrollbar-width: thin;
    scrollbar-color: var(--color-surface-high) transparent;
    /* Peek del siguiente card en mobile */
    padding-right: 2rem;
  }

  .classes-scroll::-webkit-scrollbar {
    height: 4px;
  }
  .classes-scroll::-webkit-scrollbar-track {
    background: transparent;
  }
  .classes-scroll::-webkit-scrollbar-thumb {
    background-color: var(--color-surface-high);
    border-radius: 99px;
  }

  .classes-card {
    flex-shrink: 0;
    width: 270px;
    scroll-snap-align: start;
  }

  /* En pantallas grandes las 5 cards se reparten el ancho */
  @media (min-width: 1200px) {
    .classes-scroll {
      overflow-x: visible;
      padding-right: 0;
      padding-bottom: 0;
    }
    .classes-card {
      flex: 1 1 0;
      width: auto;
      min-width: 0;
    }
  }
</style>
