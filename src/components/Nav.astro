---
const navLinks = [
  { href: '#sobre-nosotros', label: 'Nosotros' },
  { href: '#clases',         label: 'Clases' },
  { href: '#galeria',        label: 'Galería' },
  { href: '#testimonios',    label: 'Testimonios' },
  { href: '#horarios',       label: 'Horarios' },
  { href: '#contacto',       label: 'Contacto' },
];
---

<header id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <nav class="flex items-center justify-between px-8 py-4 w-full">

    <!-- Logo -->
    <a href={import.meta.env.BASE_URL} aria-label="Inicio — Universo Pilates Clásico"style="margin-left: 1rem;">
      <img src={`${import.meta.env.BASE_URL}/logo.svg`} alt="Universo Pilates Clásico" class="nav-logo h-20 w-auto" />
    </a>

    <!-- Links desktop -->
    <ul class="hidden md:flex gap-8">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="text-sm font-semibold uppercase tracking-widest transition-opacity duration-200 hover:opacity-60"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- Instagram + Hamburger -->
    <div class="flex items-center gap-4" style="margin-right: 1rem;">
      <a
        href="https://www.instagram.com/universopilatesclasico/"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-flex text-sm font-semibold uppercase tracking-widest transition-opacity hover:opacity-60"
        aria-label="Instagram de Universo Pilates Clásico"
      >
        Instagram
      </a>

      <!-- Hamburger (mobile) -->
      <button
        id="menu-toggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        class="md:hidden flex flex-col gap-1.5 p-1"
      >
        <span class="hamburger-line block w-6 h-0.5 transition-all duration-300"></span>
        <span class="hamburger-line block w-6 h-0.5 transition-all duration-300"></span>
        <span class="hamburger-line block w-6 h-0.5 transition-all duration-300"></span>
      </button>
    </div>
  </nav>

  <!-- Menú mobile -->
  <div id="mobile-menu" class="hidden md:hidden px-6 pb-6">
    <ul class="flex flex-col items-center gap-4">
      {navLinks.map(link => (
        <li>
          <a
            href={link.href}
            class="mobile-nav-link block text-base font-semibold uppercase tracking-widest py-1 text-center transition-opacity hover:opacity-60"
          >
            {link.label}
          </a>
        </li>
      ))}
      <li>
        <a
          href="https://www.instagram.com/universopilatesclasico/"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-base font-semibold uppercase tracking-widest py-1 text-center transition-opacity hover:opacity-60"
          style="margin-bottom: .5rem;"
        >
          Instagram
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  const nav = document.getElementById('main-nav');
  const toggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  // Scroll: transparente → blur+bg al pasar 80px
  window.addEventListener('scroll', () => {
    if (window.scrollY > 80) {
      nav?.classList.add('scrolled');
    } else {
      nav?.classList.remove('scrolled');
    }
  }, { passive: true });

  // Hamburger toggle
  toggle?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('hidden') === false;
    mobileMenu?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isOpen));
    toggle.classList.toggle('menu-open');
  });

  // Cerrar menú al hacer click en un link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.classList.remove('menu-open');
    });
  });
</script>

<style>
  /* === ESTADO INICIAL (sobre el hero oscuro) === */
  #main-nav {
    color: #ffffff;
    background: transparent;
    transition: color 0.3s ease, background 0.3s ease, border-color 0.3s ease;
  }

  /* Logo invertido a blanco cuando está sobre el hero */
  #main-nav:not(.scrolled) .nav-logo {
    filter: brightness(0) invert(1);
    transition: filter 0.3s ease;
  }

  /* Hamburger blanco sobre el hero */
  .hamburger-line {
    background-color: #ffffff;
    transition: background-color 0.3s ease, transform 0.3s ease, opacity 0.3s ease;
  }

  /* === ESTADO SCROLLED (fondo claro) === */
  #main-nav.scrolled {
    color: var(--color-on-surface);
    background: color-mix(in srgb, var(--color-surface) 85%, transparent);
    backdrop-filter: blur(var(--nav-blur));
    border-bottom: 1px solid var(--color-surface-high);
  }

  #main-nav.scrolled .nav-logo {
    filter: none;
  }

  #main-nav.scrolled .hamburger-line {
    background-color: var(--color-on-surface);
  }

  /* Mobile menu bg */
  #mobile-menu {
    background: color-mix(in srgb, var(--color-surface) 95%, transparent);
    backdrop-filter: blur(var(--nav-blur));
    border-top: 1px solid var(--color-surface-high);
    color: var(--color-on-surface);
  }

  /* Animación hamburger → X */
  #menu-toggle.menu-open .hamburger-line:nth-child(1) {
    transform: translateY(8px) rotate(45deg);
  }
  #menu-toggle.menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
  }
  #menu-toggle.menu-open .hamburger-line:nth-child(3) {
    transform: translateY(-8px) rotate(-45deg);
  }
</style>
